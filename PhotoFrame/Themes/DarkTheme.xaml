<!-- DarkTheme.xaml — Тёмная тема: тёмный фон, светлый текст -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Фоны -->
    <SolidColorBrush x:Key="BgBrush"          Color="#111111"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Surface2Brush"    Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#3C3C3C"/>
    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A84D8"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#006CC1"/>
    <!-- Текст — СВЕТЛЫЙ на тёмном фоне -->
    <SolidColorBrush x:Key="TextPrimary"      Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextSecondary"    Color="#A0A0A0"/>
    <!-- Тулбар и оверлеи -->
    <SolidColorBrush x:Key="OverlayBgBrush"  Color="#CC111111"/>
    <SolidColorBrush x:Key="ToolbarBgBrush"  Color="#E8161616"/>
    <!-- Диалог -->
    <SolidColorBrush x:Key="DialogBgBrush"   Color="#1E1E1E"/>
    <!-- Фон ListBox/ComboBox/TextBox -->
    <SolidColorBrush x:Key="InputBgBrush"    Color="#2A2A2A"/>
    <SolidColorBrush x:Key="InputFgBrush"    Color="#F0F0F0"/>
</ResourceDictionary>
