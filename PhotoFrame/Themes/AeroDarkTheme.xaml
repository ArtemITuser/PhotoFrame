<!-- Themes/AeroDarkTheme.xaml — v1.0 (build 52)
     Тёмный вариант Aero7 ("Aero Black"). Подключается ПОВЕРХ AeroTheme.xaml
     (после него в MergedDictionaries), когда одновременно активны:
       UiMode  == Aero7
       AppTheme == Dark (либо System, если ОС в тёмном режиме)
     Переопределяет только те ключи AeroTheme.xaml, которые зашиты как
     светлое стекло (литеральные цвета, не DynamicResource):
       базовая палитра (ToolbarBgBrush, Surface*, Text*, Accent*, Input*, Popup*)
       SecondaryButton — графитовое стекло вместо серебряного
       NavItem         — тёмная стеклянная пилюля вместо голубой
       SectionHeader   — свечение адаптировано под тёмный фон
       CheckBox        — тёмное стекло вместо светло-голубого
     AccentButton (синее стекло) намеренно НЕ переопределяется — синий
     акцент одинаково хорошо читается на светлом и тёмном фоне, как и в
     оригинальном Aero (Windows 7 "Aero" сохранял акцентный цвет вне
     зависимости от цветовой схемы окна).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Базовая тёмная Aero-палитра ═══════════════════════════════════════ -->
    <SolidColorBrush x:Key="ToolbarBgBrush" Color="#E5081420"/>
    <SolidColorBrush x:Key="DialogBgBrush"  Color="#F0141B24"/>
    <SolidColorBrush x:Key="Surface2Brush"  Color="#1C2733"/>
    <SolidColorBrush x:Key="SurfaceBrush"   Color="#162029"/>
    <SolidColorBrush x:Key="BorderBrush"    Color="#3A5B7A"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#EAF3FC"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#9FC0DE"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="#4FA6F0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#6DB8F5"/>
    <SolidColorBrush x:Key="AccentPressBrush"  Color="#2F7FCC"/>
    <SolidColorBrush x:Key="InputBgBrush"      Color="#101820"/>
    <SolidColorBrush x:Key="InputFgBrush"      Color="#EAF3FC"/>
    <SolidColorBrush x:Key="InputBorderBrush"  Color="#3D5F82"/>
    <SolidColorBrush x:Key="PopupBgBrush"      Color="#F0141B24"/>
    <SolidColorBrush x:Key="EmptyIconBrush"    Color="#5C93C4"/>
    <SolidColorBrush x:Key="EmptyTextBrush"    Color="#8FB4D8"/>

    <!-- ══ SecondaryButton — графитовое стекло ═══════════════════════════════ -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Foreground"             Value="#EAF3FC"/>
        <Setter Property="BorderThickness"        Value="1"/>
        <Setter Property="Padding"                Value="16,5"/>
        <Setter Property="MinHeight"              Value="34"/>
        <Setter Property="FontSize"               Value="13"/>
        <Setter Property="FontFamily"             Value="Segoe UI"/>
        <Setter Property="Cursor"                 Value="Hand"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Outer" CornerRadius="5" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF5A6B7A" Offset="0"/>
                                    <GradientStop Color="#FF283440" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF3C4652" Offset="0"/>
                                    <GradientStop Color="#FF262E38" Offset="0.48"/>
                                    <GradientStop Color="#FF181F27" Offset="0.50"/>
                                    <GradientStop Color="#FF222A33" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Gloss" CornerRadius="4,4,0,0"
                                Margin="1,1,1,0" VerticalAlignment="Top" Height="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33FFFFFF" Offset="0"/>
                                    <GradientStop Color="#08FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.62"/>
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.15"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ NavItem — тёмная стеклянная пилюля ═════════════════════════════════ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground"                 Value="#D7E7F7"/>
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="FontSize"                   Value="13"/>
        <Setter Property="FontFamily"                 Value="Segoe UI"/>
        <Setter Property="Padding"                    Value="14,12"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="MinHeight"                  Value="44"/>
        <Setter Property="Stylus.IsFlicksEnabled"     Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Gloss" CornerRadius="4,4,0,0"
                                Margin="5,2,5,0" Height="10"
                                VerticalAlignment="Top" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#552B4A6B" Offset="0"/>
                                        <GradientStop Color="#442243" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#664FA6F0"/>
                            <Setter TargetName="Gloss" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#552F6FA8" Offset="0"/>
                                        <GradientStop Color="#772F7FCC" Offset="0.48"/>
                                        <GradientStop Color="#992A6BB5" Offset="0.50"/>
                                        <GradientStop Color="#772F7FCC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF6DB8F5" Offset="0"/>
                                        <GradientStop Color="#FF2F7FCC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Gloss" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ SectionHeader — свечение адаптировано под тёмный фон ══════════════ -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7FC3F5"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin"     Value="0,14,0,6"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#664FA6F0" Direction="270"
                                  ShadowDepth="0" BlurRadius="4" Opacity="0.9"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ CheckBox — тёмное стекло ════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"             Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize"               Value="13"/>
        <Setter Property="FontFamily"             Value="Segoe UI"/>
        <Setter Property="Cursor"                 Value="Hand"/>
        <Setter Property="MinHeight"              Value="40"/>
        <Setter Property="Padding"                Value="6,8"/>
        <Setter Property="Margin"                 Value="0,3"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3"
                                BorderThickness="1" VerticalAlignment="Center"
                                Margin="0,0,7,0" SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF6DB8F5" Offset="0"/>
                                    <GradientStop Color="#FF2F7FCC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF283544" Offset="0"/>
                                    <GradientStop Color="#FF17222D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border CornerRadius="2,2,0,0" VerticalAlignment="Top"
                                    Height="7" Margin="1,1,1,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock x:Name="Mark" Text="✔" FontSize="11"
                                   Foreground="#7FC3F5" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="-24,0,6,0"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"/>
                        <ContentPresenter VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
