<!-- LightTheme.xaml — Светлая тема: светлый фон, тёмный текст -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Фоны -->
    <SolidColorBrush x:Key="BgBrush"          Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush"    Color="#EBEBEB"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#C8C8C8"/>
    <!-- Акцент -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A74C8"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#005EAD"/>
    <!-- Текст — ТЁМНЫЙ на светлом фоне -->
    <SolidColorBrush x:Key="TextPrimary"      Color="#111111"/>
    <SolidColorBrush x:Key="TextSecondary"    Color="#555555"/>
    <!-- Тулбар и оверлеи -->
    <SolidColorBrush x:Key="OverlayBgBrush"  Color="#CCF5F5F5"/>
    <SolidColorBrush x:Key="ToolbarBgBrush"  Color="#F0F0F0"/>
    <!-- Диалог -->
    <SolidColorBrush x:Key="DialogBgBrush"   Color="#FFFFFF"/>
    <!-- Фон ListBox/ComboBox/TextBox -->
    <SolidColorBrush x:Key="InputBgBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputFgBrush"    Color="#111111"/>
</ResourceDictionary>
