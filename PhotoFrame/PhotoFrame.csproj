<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10</LangVersion>
    <AssemblyName>PhotoFrame</AssemblyName>
    <RootNamespace>PhotoFrame</RootNamespace>

    <!-- Единственное место для версии. Читается через Assembly.GetExecutingAssembly() -->
    <!-- v3.3: единая версия Free-сборки; CI переопределяет через -p:Version=... -->
    <Version>1.2.3.1</Version>
    <AssemblyVersion>1.2.3</AssemblyVersion>
    <FileVersion>1.2.3.1.63</FileVersion>
    <InformationalVersion>1.2.3.1+build.63</InformationalVersion>

    <Product>PhotoFrame — Фоторамка</Product>
    <Company>ArtemITuser</Company>
    <Copyright>© 2025 @ArtemITuser Ochkin Artyom</Copyright>
    <Description>Цифровая фоторамка с анимированными переходами для Windows</Description>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Resources\Icons\Media001.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Management для WMI DeviceChangeEvent (определение съёмных носителей) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.png" />
    <Resource Include="Resources\Icons\*.ico" />
  </ItemGroup>
</Project>
