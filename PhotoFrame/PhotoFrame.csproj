<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 1. Указываем SDK Windows 10 (билд 19041 — база для 2004+) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    
    <!-- 2. Указываем МИНИМАЛЬНУЮ версию для запуска -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10</LangVersion>
    <AssemblyName>PhotoFrame</AssemblyName>
    <RootNamespace>PhotoFrame</RootNamespace>
    <Version>0.3.1</Version>
    <Product>PhotoFrame — Фоторамка</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- 3. Нативная поддержка всех архитектур (AnyCPU + Prefer32Bit=false) -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    
    <ApplicationIcon>Resources\Icons\Media001.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.png" />
    <Resource Include="Resources\Icons\*.ico" />
  </ItemGroup>
</Project>