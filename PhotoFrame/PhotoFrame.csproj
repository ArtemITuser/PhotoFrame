<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10</LangVersion>
    <AssemblyName>PhotoFrame</AssemblyName>
    <RootNamespace>PhotoFrame</RootNamespace>

    <!-- Единственное место для версии. Читается через Assembly.GetExecutingAssembly() -->
    <!-- v3.3: единая версия Free-сборки; CI переопределяет через -p:Version=... -->
    <!-- Единственное место версии. CI переопределяет Version/AssemblyVersion/FileVersion/
         InformationalVersion явно из тега (-p:...), поэтому здесь не задаём AssemblyVersion/
         FileVersion/InformationalVersion — их хардкод приводил к устаревшей версии в UI. -->
    <Version>1.2.4.0</Version>

    <Product>PhotoFrame — Фоторамка</Product>
    <Company>ArtemITuser</Company>
    <Copyright>© 2025 @ArtemITuser Ochkin Artyom</Copyright>
    <Description>Цифровая фоторамка с анимированными переходами для Windows</Description>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Resources\Icons\Media001.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Management для WMI DeviceChangeEvent (определение съёмных носителей) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Management для WMI; Microsoft.CSharp для dynamic JSON в новых сервисах
         (ProfileService/SmartCollectionService/ReverseGeocodeService перенесены из b62). -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.png" />
    <Resource Include="Resources\Icons\*.ico" />
  </ItemGroup>
</Project>
