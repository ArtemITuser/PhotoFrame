<!-- MainWindow.xaml — v3.1
     Изменения:
       • Кнопка PlayMode — только 2 состояния (Shuffle / Sequential), с подписью
       • Все кнопки тулбара имеют TextBlock-подпись снизу для touchscreen
       • Touch-режим: IsManipulationEnabled=True на Grid (не только Window)
       • Все статические иконки — Segoe MDL2 Assets в XAML (не зависит от PNG)
       • Иконки Play/Pause, Fullscreen, PlayMode меняются через код (.Text)
-->
<Window x:Class="PhotoFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoFrame"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="Black"
        WindowStyle="None"
        AllowsTransparency="False"
        Loaded="OnLoaded"
        Closing="OnClosing"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove"
        MouseDown="OnMouseDown"
        MouseLeave="OnMouseLeave"
        StateChanged="OnStateChanged">

    <!-- IsManipulationEnabled на Grid, а не на Window — лучше работает с touch -->
    <Grid x:Name="RootGrid" ClipToBounds="True"
          IsManipulationEnabled="True"
          ManipulationStarted="OnManipulationStarted"
          ManipulationCompleted="OnManipulationCompleted">

        <!-- Чёрный фон -->
        <Rectangle Fill="Black"/>

        <!-- ── Слой A (текущее фото) ──────────────────────────────── -->
        <Image x:Name="ImgA" Stretch="Uniform" StretchDirection="Both"
               IsHitTestVisible="False"/>

        <!-- ── Слой B (следующее фото) ───────────────────────────── -->
        <Image x:Name="ImgB" Stretch="Uniform" StretchDirection="Both"
               Opacity="0" IsHitTestVisible="False"/>

        <!-- ── Оверлей: директория (левый верх) ─────────────────── -->
        <Border x:Name="OverlayDir"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Style="{DynamicResource OverlayBadge}"
                Margin="18,18,0,0" MaxWidth="500"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbDir"
                       Style="{DynamicResource OverlayText}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>

        <!-- ── Оверлей: GPS (верх по центру) ────────────────────── -->
        <Border x:Name="OverlayLoc"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Style="{DynamicResource OverlayBadge}"
                Margin="0,18,0,0" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbLoc"
                       Style="{DynamicResource OverlayText}"
                       TextAlignment="Center"/>
        </Border>

        <!-- ── Оверлей: дата (правый низ) ───────────────────────── -->
        <Border x:Name="OverlayDate"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Style="{DynamicResource OverlayBadge}"
                Margin="0,0,18,80" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbDate" Style="{DynamicResource OverlayText}"/>
        </Border>

        <!-- ── Счётчик фото (центр, над тулбаром) ───────────────── -->
        <Border x:Name="CounterBadge"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Style="{DynamicResource OverlayBadge}"
                Margin="0,0,0,80" IsHitTestVisible="False">
            <TextBlock x:Name="TbCounter"
                       Style="{DynamicResource OverlayText}"
                       FontSize="12" Opacity="0.8"/>
        </Border>

        <!-- ── Пустое состояние ──────────────────────────────────── -->
        <StackPanel x:Name="EmptyPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                       FontSize="72" Foreground="#555"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Папки не выбраны или фотографии не найдены"
                       Foreground="#777" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       FontFamily="Segoe UI"/>
            <Button Content="Открыть настройки"
                    Style="{DynamicResource AccentButton}"
                    HorizontalAlignment="Center" Padding="28,9"
                    Click="OnBtnSettings"/>
        </StackPanel>

        <!-- ── Индикатор сканирования ─────────────────────────────── -->
        <Border x:Name="ScanPanel" Background="#CC000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Поиск фотографий…"
                           Foreground="White" FontSize="18" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TbScanPath"
                           Foreground="#AAA" FontSize="11" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="600"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════ ТУЛБАР ════════════════════════════ -->
        <!-- Высота увеличена до 76px для подписей под кнопками (touch-friendly) -->
        <Border x:Name="Toolbar" VerticalAlignment="Bottom"
                Background="{DynamicResource ToolbarBgBrush}" Height="76">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarSlide" Y="0"/>
            </Border.RenderTransform>

            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Левая: режим + интервал ──────────────────────── -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Кнопка режима: только 2 состояния (Shuffle / Sequential) -->
                    <Button x:Name="BtnPlayMode"
                            Style="{DynamicResource IconButton}"
                            Width="56" Height="56"
                            Click="OnBtnPlayMode">
                        <StackPanel>
                            <TextBlock x:Name="TbPlayModeIcon"
                                       Text="&#xE8B1;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbPlayModeLabel"
                                       Text="Случайно"
                                       FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Уменьшить интервал -->
                    <Button Style="{DynamicResource IconButton}"
                            Width="44" Height="56"
                            ToolTip="Уменьшить интервал"
                            Click="OnIntervalDown">
                        <StackPanel>
                            <TextBlock Text="&#x2212;" FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Меньше" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Значение интервала -->
                    <Border Background="#22FFFFFF" CornerRadius="4"
                            Padding="8,3" Margin="2,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TbInterval"
                                   Foreground="White" FontSize="13" FontFamily="Segoe UI"
                                   MinWidth="38" TextAlignment="Center"/>
                    </Border>

                    <!-- Увеличить интервал -->
                    <Button Style="{DynamicResource IconButton}"
                            Width="44" Height="56"
                            ToolTip="Увеличить интервал"
                            Click="OnIntervalUp">
                        <StackPanel>
                            <TextBlock Text="+" FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Больше" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ── Центральная: навигация ──────────────────────── -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <Button x:Name="BtnPrev"
                            Style="{DynamicResource IconButton}"
                            Width="56" Height="56"
                            Click="OnBtnPrev">
                        <StackPanel>
                            <TextBlock x:Name="TbPrevIcon" Text="&#xE892;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Назад" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Play / Pause -->
                    <Button x:Name="BtnPlayPause"
                            Style="{DynamicResource IconButton}"
                            Width="64" Height="64"
                            Click="OnBtnPlayPause">
                        <StackPanel>
                            <TextBlock x:Name="TbPlayIcon"
                                       Text="&#xE768;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbPlayLabel"
                                       Text="Пуск" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNext"
                            Style="{DynamicResource IconButton}"
                            Width="56" Height="56"
                            Click="OnBtnNext">
                        <StackPanel>
                            <TextBlock x:Name="TbNextIcon" Text="&#xE893;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Вперёд" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ── Правая: тема, настройки, полный экран ──────── -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="BtnTheme"
                            Style="{DynamicResource IconButton}"
                            Width="56" Height="56"
                            Click="OnBtnTheme">
                        <StackPanel>
                            <TextBlock x:Name="TbThemeIcon"
                                       Text="&#xE706;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Тема" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSettings"
                            Style="{DynamicResource IconButton}"
                            Width="56" Height="56"
                            Click="OnBtnSettings">
                        <StackPanel>
                            <TextBlock x:Name="TbSettingsIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Настройки" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnFullscreen"
                            Style="{DynamicResource IconButton}"
                            Width="56" Height="56"
                            Click="OnBtnFullscreen">
                        <StackPanel>
                            <TextBlock x:Name="TbFullscreenIcon"
                                       Text="&#xE740;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbFullscreenLabel"
                                       Text="Экран" FontFamily="Segoe UI" FontSize="9"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Строка заголовка ────────────────────────────────────── -->
        <Border x:Name="TitleBar" Height="32" VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Margin="8,0">
                <TextBlock x:Name="TbTitleVersion"
                           Text="PhotoFrame" Foreground="#60FFFFFF"
                           FontSize="12" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource IconButton}"
                            Width="32" Height="32" ToolTip="Свернуть" Click="OnMinimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="BtnMaximize"
                            Style="{DynamicResource IconButton}"
                            Width="32" Height="32" ToolTip="Развернуть" Click="OnMaximize">
                        <TextBlock x:Name="TbMaxIcon"
                                   Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{DynamicResource IconButton}"
                            Width="32" Height="32" ToolTip="Закрыть" Click="OnClose">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
