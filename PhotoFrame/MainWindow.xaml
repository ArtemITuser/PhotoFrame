<!-- MainWindow.xaml — главное окно слайдшоу.
     ВАЖНО: Все кнопки тулбара имеют ВСТРОЕННЫЙ контент (TextBlock с Segoe MDL2 Assets).
     Это устраняет NullRef, возникавший при попытке задать контент через код
     до завершения инициализации окна.
     Только иконки Play/Pause, Theme, Fullscreen и PlayMode меняются в коде
     через именованные TextBlock внутри кнопок. -->
<Window x:Class="PhotoFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoFrame"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="Black"
        WindowStyle="None"
        AllowsTransparency="False"
        IsManipulationEnabled="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove"
        MouseDown="OnMouseDown"
        MouseLeave="OnMouseLeave"
        StateChanged="OnStateChanged"
        ManipulationStarted="OnManipulationStarted"
        ManipulationCompleted="OnManipulationCompleted">

    <Grid x:Name="RootGrid" ClipToBounds="True">

        <!-- Чёрный фон -->
        <Rectangle Fill="Black"/>

        <!-- ── Слой A (текущее фото) ──────────────────────────────── -->
        <Image x:Name="ImgA" Stretch="Uniform" StretchDirection="Both"
               IsHitTestVisible="False"/>

        <!-- ── Слой B (следующее фото) ───────────────────────────── -->
        <Image x:Name="ImgB" Stretch="Uniform" StretchDirection="Both"
               Opacity="0" IsHitTestVisible="False"/>

        <!-- ── Оверлей: директория (левый верх) ─────────────────── -->
        <Border x:Name="OverlayDir"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Style="{DynamicResource OverlayBadge}"
                Margin="18,18,0,0" MaxWidth="500"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbDir"
                       Style="{DynamicResource OverlayText}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>

        <!-- ── Оверлей: GPS (верх по центру) ────────────────────── -->
        <Border x:Name="OverlayLoc"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Style="{DynamicResource OverlayBadge}"
                Margin="0,18,0,0" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbLoc"
                       Style="{DynamicResource OverlayText}"
                       TextAlignment="Center"/>
        </Border>

        <!-- ── Оверлей: дата (правый низ) ───────────────────────── -->
        <Border x:Name="OverlayDate"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Style="{DynamicResource OverlayBadge}"
                Margin="0,0,18,72" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbDate" Style="{DynamicResource OverlayText}"/>
        </Border>

        <!-- ── Счётчик фото (центр, над тулбаром) ───────────────── -->
        <Border x:Name="CounterBadge"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Style="{DynamicResource OverlayBadge}"
                Margin="0,0,0,70" IsHitTestVisible="False">
            <TextBlock x:Name="TbCounter"
                       Style="{DynamicResource OverlayText}"
                       FontSize="12" Opacity="0.8"/>
        </Border>

        <!-- ── Пустое состояние ──────────────────────────────────── -->
        <StackPanel x:Name="EmptyPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <!-- Иконка папки через Segoe MDL2 — без зависимости от PNG -->
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                       FontSize="72" Foreground="#555"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Папки не выбраны или фотографии не найдены"
                       Foreground="#777" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       FontFamily="Segoe UI"/>
            <Button Content="Открыть настройки"
                    Style="{DynamicResource AccentButton}"
                    HorizontalAlignment="Center" Padding="28,9"
                    Click="OnBtnSettings"/>
        </StackPanel>

        <!-- ── Индикатор сканирования ─────────────────────────────── -->
        <Border x:Name="ScanPanel" Background="#CC000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Поиск фотографий…"
                           Foreground="White" FontSize="18"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TbScanPath"
                           Foreground="#AAA" FontSize="11"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="600"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════ ТУЛБАР ════════════════════════════ -->
        <!-- Тулбар в оконном режиме ВСЕГДА виден; в полноэкранном — автоскрывается -->
        <Border x:Name="Toolbar" VerticalAlignment="Bottom"
                Background="{DynamicResource ToolbarBgBrush}" Height="62">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarSlide" Y="0"/>
            </Border.RenderTransform>

            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Левая группа: режим воспроизведения + интервал ──── -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Режим (shuffle / sequential / random / date) -->
                    <Button x:Name="BtnPlayMode"
                            Style="{DynamicResource IconButton}"
                            Width="40" Height="40"
                            ToolTip="Режим воспроизведения  (клик — следующий режим)"
                            Click="OnBtnPlayMode">
                        <!-- TbPlayModeIcon обновляется в коде при смене режима -->
                        <TextBlock x:Name="TbPlayModeIcon"
                                   Text="&#xE8B1;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Уменьшить интервал -->
                    <Button Style="{DynamicResource IconButton}"
                            Width="34" Height="40"
                            ToolTip="Уменьшить интервал"
                            Click="OnIntervalDown">
                        <TextBlock Text="&#x2212;" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Значение интервала -->
                    <Border Background="#22FFFFFF" CornerRadius="4"
                            Padding="8,3" Margin="2,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TbInterval"
                                   Foreground="White" FontSize="13" FontFamily="Segoe UI"
                                   MinWidth="38" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Увеличить интервал -->
                    <Button Style="{DynamicResource IconButton}"
                            Width="34" Height="40"
                            ToolTip="Увеличить интервал"
                            Click="OnIntervalUp">
                        <TextBlock Text="+" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- ── Центральная группа: навигация ──────────────────── -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Назад -->
                    <Button x:Name="BtnPrev"
                            Style="{DynamicResource IconButton}"
                            Width="40" Height="40" ToolTip="Предыдущее  ←"
                            Click="OnBtnPrev">
                        <!-- Segoe MDL2: SkipBack10 \uE892 -->
                        <TextBlock Text="&#xE892;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Play / Pause — иконка переключается в коде -->
                    <Button x:Name="BtnPlayPause"
                            Style="{DynamicResource IconButton}"
                            Width="50" Height="50"
                            ToolTip="Пауза / Пуск  Пробел"
                            Click="OnBtnPlayPause">
                        <!-- \uE768 = Play, \uE769 = Pause (Segoe MDL2) -->
                        <TextBlock x:Name="TbPlayIcon"
                                   Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Вперёд -->
                    <Button x:Name="BtnNext"
                            Style="{DynamicResource IconButton}"
                            Width="40" Height="40" ToolTip="Следующее  →"
                            Click="OnBtnNext">
                        <!-- Segoe MDL2: SkipForward10 \uE893 -->
                        <TextBlock Text="&#xE893;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- ── Правая группа: тема, настройки, полный экран ──── -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Сменить тему — иконка меняется в коде -->
                    <Button x:Name="BtnTheme"
                            Style="{DynamicResource IconButton}"
                            Width="40" Height="40" ToolTip="Сменить тему (Тёмная / Светлая)"
                            Click="OnBtnTheme">
                        <!-- \uE708 = Тёмная (луна), \uE706 = Светлая (солнце) - Segoe MDL2 -->
                        <TextBlock x:Name="TbThemeIcon"
                                   Text="&#xE706;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Настройки — \uE713 = Gear -->
                    <Button x:Name="BtnSettings"
                            Style="{DynamicResource IconButton}"
                            Width="40" Height="40" ToolTip="Настройки  Ctrl+,"
                            Click="OnBtnSettings">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Полный экран — иконка меняется в коде -->
                    <Button x:Name="BtnFullscreen"
                            Style="{DynamicResource IconButton}"
                            Width="40" Height="40" ToolTip="Полный экран  F / F11"
                            Click="OnBtnFullscreen">
                        <!-- \uE740 = FullScreen, \uE741 = BackToWindow (Segoe MDL2) -->
                        <TextBlock x:Name="TbFullscreenIcon"
                                   Text="&#xE740;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Строка заголовка (перетаскивание + системные кнопки) ─── -->
        <Border x:Name="TitleBar" Height="30" VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Margin="8,0">
                <TextBlock Text="PhotoFrame" Foreground="#60FFFFFF"
                           FontSize="12" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Свернуть -->
                    <Button Style="{DynamicResource IconButton}"
                            Width="30" Height="30"
                            ToolTip="Свернуть" Click="OnMinimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <!-- Развернуть/восстановить -->
                    <Button x:Name="BtnMaximize"
                            Style="{DynamicResource IconButton}"
                            Width="30" Height="30"
                            ToolTip="Развернуть" Click="OnMaximize">
                        <TextBlock x:Name="TbMaxIcon"
                                   Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <!-- Закрыть -->
                    <Button Style="{DynamicResource IconButton}"
                            Width="30" Height="30"
                            ToolTip="Закрыть" Click="OnClose">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
