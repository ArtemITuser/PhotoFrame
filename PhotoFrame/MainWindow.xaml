<!-- MainWindow.xaml — v4.0 (build 43)
     Transparency: AllowsTransparency=True + WindowStyle=None + Background=Transparent.
     DWM Acrylic/Mica visible through transparent WPF background.
     Touch: SwipeZone under toolbar, all buttons Stylus.IsFlicksEnabled=False.
     Aero7: toolbar buttons swap to Aero7ToolbarButton style at runtime.
             caption buttons swap to Aero7CaptionButton style at runtime.
             PNG icons loaded by IconHelper from Resources/Icons/.
     Modern: ToolbarButton style + Segoe MDL2 Assets glyphs.
-->
<Window x:Class="PhotoFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoFrame"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Loaded="OnLoaded"
        Closing="OnClosing"
        KeyDown="OnKeyDown"
        MouseMove="OnMouseMove"
        MouseLeave="OnMouseLeave"
        StateChanged="OnStateChanged">

    <Grid x:Name="RootGrid" ClipToBounds="True">

        <!-- Semi-transparent main background — DWM Acrylic/Mica shows through -->
        <Rectangle x:Name="MainBgRect"
                   Fill="{DynamicResource MainBgBrush}"
                   IsHitTestVisible="False"/>

        <!-- Photo layers -->
        <Image x:Name="ImgA" Stretch="Uniform" StretchDirection="Both"
               IsHitTestVisible="False"/>
        <Image x:Name="ImgB" Stretch="Uniform" StretchDirection="Both"
               Opacity="0" IsHitTestVisible="False"/>

        <!-- SwipeZone: touch swipes over photo, below toolbar -->
        <Rectangle x:Name="SwipeZone"
                   Fill="Transparent"
                   Margin="0,32,0,72"
                   IsManipulationEnabled="True"
                   Stylus.IsFlicksEnabled="False"
                   ManipulationStarting="OnManipulationStarting"
                   ManipulationInertiaStarting="OnManipulationInertiaStarting"
                   ManipulationDelta="OnManipulationDelta"
                   MouseDown="OnPhotoAreaMouseDown"
                   MouseRightButtonUp="OnRightClick"/>

        <!-- Overlay: directory (top-left) -->
        <Border x:Name="OverlayDir" HorizontalAlignment="Left" VerticalAlignment="Top"
                Style="{DynamicResource OverlayBadge}" Margin="12,36,0,0" MaxWidth="500"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbDir" Style="{DynamicResource OverlayText}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>

        <!-- Overlay: GPS (top centre) -->
        <Border x:Name="OverlayLoc" HorizontalAlignment="Center" VerticalAlignment="Top"
                Style="{DynamicResource OverlayBadge}" Margin="0,36,0,0"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbLoc" Style="{DynamicResource OverlayText}"
                       TextAlignment="Center"/>
        </Border>

        <!-- Overlay: date (bottom-right) -->
        <Border x:Name="OverlayDate" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Style="{DynamicResource OverlayBadge}" Margin="0,0,12,76"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="TbDate" Style="{DynamicResource OverlayText}"/>
        </Border>

        <!-- Counter (centre bottom) -->
        <Border x:Name="CounterBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Style="{DynamicResource OverlayBadge}" Margin="0,0,0,76"
                IsHitTestVisible="False">
            <TextBlock x:Name="TbCounter" Style="{DynamicResource OverlayText}"
                       FontSize="13" Opacity="0.9"/>
        </Border>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                       FontSize="80" Foreground="{DynamicResource EmptyIconBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Папки не выбраны или фотографии не найдены"
                       Foreground="{DynamicResource EmptyTextBrush}" FontSize="16"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="Открыть настройки" Style="{DynamicResource AccentButton}"
                    HorizontalAlignment="Center" Padding="28,9" Click="OnBtnSettings"/>
        </StackPanel>

        <!-- Scanning panel -->
        <Border x:Name="ScanPanel" Background="#CC000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Поиск фотографий…" Foreground="White" FontSize="18"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TbScanPath" Foreground="#AAAAAA" FontSize="11"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="600"/>
            </StackPanel>
        </Border>

        <!-- Disk error banner -->
        <Border x:Name="DiskErrorBanner" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="0,32,0,0"
                Background="#EE8B0000" Panel.ZIndex="50">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TbDiskErrorMsg" Grid.Column="0"
                           Foreground="White" FontSize="12" FontFamily="Segoe UI"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="BtnChkdsk" Content="Проверить диск"
                            Style="{DynamicResource AccentButton}"
                            Margin="0,0,6,0" Click="OnChkdsk" FontSize="11"/>
                    <Button Content="Удалить из списка"
                            Style="{DynamicResource SecondaryButton}"
                            Margin="0,0,6,0" Click="OnRemoveErrorPath" FontSize="11"/>
                    <Button Content="✕" Width="28" Height="28" FontSize="12"
                            Background="Transparent" BorderThickness="0"
                            Foreground="White" Click="OnCloseDiskError"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Context popup -->
        <Popup x:Name="ContextPopup" Placement="MousePoint"
               AllowsTransparency="True" Focusable="False"
               StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource PopupBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" MinWidth="200">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270"
                                      ShadowDepth="4" BlurRadius="14" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TbContextFileName" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Padding="12,10,12,6" TextTrimming="CharacterEllipsis"/>
                    <Separator Style="{DynamicResource PopupSeparator}"/>
                    <Button Style="{DynamicResource ContextIconButton}" Click="OnContextNext">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE893;  " FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Следующее" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ContextIconButton}" Click="OnContextPrev">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE892;  " FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Предыдущее" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{DynamicResource PopupSeparator}"/>
                    <Button Style="{DynamicResource ContextIconButton}" Click="OnContextShowExplorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;  " FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Показать в проводнике"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource ContextIconButton}" Click="OnContextDelete">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;  " FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="#E04040"/>
                            <TextBlock Text="Удалить в корзину" Foreground="#E04040"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{DynamicResource PopupSeparator}"/>
                    <Button Style="{DynamicResource ContextIconButton}" Click="OnBtnSettings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;  " FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Настройки…"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══════════════════════════════════════════════════════
             TOOLBAR — always dark, above photo.
             Style on each button is overridden at runtime for Aero7.
        ═══════════════════════════════════════════════════════ -->
        <Border x:Name="Toolbar" VerticalAlignment="Bottom"
                Background="{DynamicResource ToolbarBgBrush}" Height="72"
                Panel.ZIndex="100">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarSlide" Y="0"/>
            </Border.RenderTransform>
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: PlayMode + interval -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPlayMode"
                            Style="{DynamicResource ToolbarButton}"
                            Width="56" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            Click="OnBtnPlayMode">
                        <StackPanel>
                            <TextBlock x:Name="TbPlayModeIcon" Text="&#xE8B1;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbPlayModeLabel" Text="Случайно"
                                       Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnIntervalDown"
                            Style="{DynamicResource ToolbarButton}"
                            Width="44" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            ToolTip="Меньше" Click="OnIntervalDown">
                        <StackPanel>
                            <TextBlock Text="&#x2212;" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="−" Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                    <Border Background="#BB000000" CornerRadius="4" Padding="8,3"
                            Margin="2,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TbInterval" Foreground="White"
                                   FontSize="13" FontFamily="Segoe UI"
                                   MinWidth="38" TextAlignment="Center"/>
                    </Border>
                    <Button x:Name="BtnIntervalUp"
                            Style="{DynamicResource ToolbarButton}"
                            Width="44" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            ToolTip="Больше" Click="OnIntervalUp">
                        <StackPanel>
                            <TextBlock Text="+" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="+" Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Centre: navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnPrev"
                            Style="{DynamicResource ToolbarButton}"
                            Width="56" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            ToolTip="Назад" Click="OnBtnPrev">
                        <StackPanel>
                            <TextBlock x:Name="TbPrevIcon" Text="&#xE892;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Назад" Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPlayPause"
                            Style="{DynamicResource ToolbarButton}"
                            Width="64" Height="64"
                            Stylus.IsFlicksEnabled="False"
                            Click="OnBtnPlayPause">
                        <StackPanel>
                            <TextBlock x:Name="TbPlayIcon" Text="&#xE768;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbPlayLabel" Text="Пуск"
                                       Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNext"
                            Style="{DynamicResource ToolbarButton}"
                            Width="56" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            ToolTip="Вперёд" Click="OnBtnNext">
                        <StackPanel>
                            <TextBlock x:Name="TbNextIcon" Text="&#xE893;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Вперёд" Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: theme, settings, fullscreen -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTheme"
                            Style="{DynamicResource ToolbarButton}"
                            Width="56" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            Click="OnBtnTheme">
                        <StackPanel>
                            <TextBlock x:Name="TbThemeIcon" Text="&#xE706;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Тема" Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSettings"
                            Style="{DynamicResource ToolbarButton}"
                            Width="56" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            ToolTip="Настройки  Ctrl+,"
                            Click="OnBtnSettings">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Настройки" Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFullscreen"
                            Style="{DynamicResource ToolbarButton}"
                            Width="56" Height="60"
                            Stylus.IsFlicksEnabled="False"
                            Click="OnBtnFullscreen">
                        <StackPanel>
                            <TextBlock x:Name="TbFullscreenIcon" Text="&#xE740;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbFullscreenLabel" Text="Экран"
                                       Style="{StaticResource HoverLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             TITLE BAR (WindowStyle=None)
             Caption button styles swapped at runtime for Aero7.
        ═══════════════════════════════════════════════════════ -->
        <Border x:Name="TitleBar" Height="32" VerticalAlignment="Top"
                Background="#22000000" Panel.ZIndex="200"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid>
                <TextBlock x:Name="TbTitleVersion" Text="PhotoFrame"
                           Foreground="#AAFFFFFF" FontSize="11" FontFamily="Segoe UI"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           IsHitTestVisible="False"/>
                <StackPanel x:Name="CaptionButtons"
                            Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- Minimize -->
                    <Button x:Name="BtnWinMin"
                            Width="46" Height="32" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Stylus.IsFlicksEnabled="False"
                            Click="OnWinMinimize" ToolTip="Свернуть">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Foreground="White"/>
                    </Button>
                    <!-- Maximize/Restore -->
                    <Button x:Name="BtnWinMax"
                            Width="46" Height="32" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Stylus.IsFlicksEnabled="False"
                            Click="OnWinMaximize">
                        <TextBlock x:Name="TbWinMax" Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Foreground="White"/>
                    </Button>
                    <!-- Close -->
                    <Button x:Name="BtnWinClose"
                            Width="46" Height="32" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Stylus.IsFlicksEnabled="False"
                            Click="OnWinClose" ToolTip="Закрыть">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
