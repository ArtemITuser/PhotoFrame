<Window x:Class="PhotoFrame.Views.MonitorFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Black" Topmost="False"
        Loaded="OnLoaded" Closing="OnClosing">
    <Grid Background="Black">
        <Image x:Name="ImgA" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="ImgB" Stretch="Uniform" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</Window>
