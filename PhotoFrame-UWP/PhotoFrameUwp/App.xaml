<!-- App.xaml — UWP (Windows.UI.Xaml) версия Application из PhotoFrame v1.2.2.0.
     StartupUri нет в UWP → жизненный цикл в App.xaml.cs (OnLaunched). -->
<Application
    x:Class="PhotoFrameUwp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Тема загружается первой — CommonStyles ссылается на её ресурсы через DynamicResource -->
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="/Themes/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
